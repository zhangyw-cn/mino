# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Explicit binary types (no line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.zip binary
*.gz binary
*.tar binary
